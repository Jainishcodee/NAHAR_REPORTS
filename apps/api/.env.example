# Copy this file to ".env" and adjust.

# --- Development (zero-setup, file-based SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production (PostgreSQL on the 'server' PC; clients use its LAN IP) ---
# DATABASE_URL="postgresql://report_app:CHANGE_ME@192.168.1.10:5432/report_db?schema=public"

# Secret used to sign login tokens. Generate a long random string for production.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# Port the API listens on. 0.0.0.0 so other PCs on the LAN can reach it.
PORT=4000
HOST=0.0.0.0

# CORS: the desktop app's dev origin. In production the Electron app uses file://,
# which is allowed automatically.
CORS_ORIGIN="http://localhost:5173"
